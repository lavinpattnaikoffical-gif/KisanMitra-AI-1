# =============================================================================
# KisanMitra AI Backend — Environment Variables
# Copy this file to .env and fill in your values
# =============================================================================

# ── Database (Neon PostgreSQL) ─────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@host:port/dbname"

# ── JWT Authentication ─────────────────────────────────────────────────────
JWT_SECRET="your_jwt_secret_here"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_EXPIRES_IN="30d"

# ── Application ────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# Allowed CORS origins (comma-separated for multiple)
CORS_ORIGIN="http://localhost:3001,http://localhost:5173"

# Public URL of this server (used for callbacks)
APP_URL="http://localhost:4000"

# ── AI Providers ───────────────────────────────────────────────────────────
AI_PROVIDER="gemini"               # gemini | openrouter | ollama

GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL="gemini-3.5-flash"

OPENROUTER_API_KEY="your_openrouter_api_key_here"
OPENROUTER_MODEL="OpenAI/gpt-oss-20b"

OLLAMA_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.2"

# ── SMS / OTP (Twilio) ─────────────────────────────────────────────────────
# Set OTP_BYPASS_MODE=true to skip SMS in development (OTP will be "000000")
OTP_BYPASS_MODE=true

TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER="+1234567890"

# ── Weather ────────────────────────────────────────────────────────────────
OPENWEATHER_API_KEY="your_openweather_api_key_here"

# ── Rate Limiting ─────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000        # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100

# ── AWS Deployment ─────────────────────────────────────────────────────────
# Set these when deploying to EC2
# APP_URL="http://43.205.94.151"
# CORS_ORIGIN="http://43.205.94.151:3001"
